%{
#include <stdio.h>
%}

%option noyywrap

KEYWORD     int|float|char|double|if|else|while|for|return|void
IDENTIFIER  [a-zA-Z_]+[a-zA-Z0-9_]*
CONSTANT    [0-9]+(\.[0-9]+)?
OPERATOR    (\+\+|--|==|!=|<=|>=|&&|\|\||[+\-*/%=<>])
PUNCTUATION [;,(){}\[\]]

%%

{KEYWORD}       { printf("%s\t: Keyword\n", yytext); }
{IDENTIFIER}    { printf("%s\t: Identifier\n", yytext); }
{CONSTANT}      { printf("%s\t: Constant\n", yytext); }
{OPERATOR}      { printf("%s\t: Operator\n", yytext); }
{PUNCTUATION}   { printf("%s\t: Punctuation\n", yytext); }

[ \t\n]+        { }
.               { printf("%s\t: Unknown Token\n", yytext); }

%%

int main(int argc, char *argv[])
{
    if(argc > 1)
    {
        FILE *fp = fopen(argv[1], "r");
        yyin = fp;
    }

    yylex();
    return 0;
}

