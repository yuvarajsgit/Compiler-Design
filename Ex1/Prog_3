%{
#include <stdio.h>
%}

%option noyywrap

FRACTION    [-+]?[0-9]+\.[0-9]+
NEGATIVE    -[0-9]+
POSITIVE    [+]?[0-9]+

%%

{FRACTION}    { printf("%s is a Fraction\n",yytext); }
{NEGATIVE}    { printf("%s is a Negative Number\n",yytext); }
{POSITIVE}    { printf("%s is a Positive Number\n",yytext); }

\n            { }
.             { }

%%

int main(int argc, char *argv[])
{
    if(argc > 1)
    {
        FILE *fp = fopen(argv[1], "r");
        yyin = fp;
    }

    yylex();
    return 0;
}
