%{
#include <stdio.h>
%}

%option noyywrap
%x UNARY

id      [a-zA-Z_][a-zA-Z0-9_]*
digit   [0-9]+

%%

{id}            {
                    printf("Identifier : %s\n", yytext);
                    BEGIN(INITIAL);
                }

{digit}         {
                    printf("Digit : %s\n", yytext);
                    BEGIN(INITIAL);
                }

"="|\+|\*|\/|%  {
                    printf("Operator : %s\n", yytext);
                    BEGIN(UNARY);
                }

"-"             {
                    printf("Subtraction\n");
                    BEGIN(UNARY);
                }

<UNARY>"-"      {
                    printf("Unary Minus\n");
                }

<UNARY>{id}     {
                    printf("Identifier : %s\n", yytext);
                    BEGIN(INITIAL);
                }

<UNARY>{digit}  {
                    printf("Digit : %s\n", yytext);
                    BEGIN(INITIAL);
                }

"("             {
                    printf("Left Parenthesis\n");
                    BEGIN(UNARY);
                }

<UNARY>"("      {
                    printf("Left Parenthesis\n");
                }

")"             {
                    printf("Right Parenthesis\n");
                    BEGIN(INITIAL);
                }

<UNARY>")"      {
                    printf("Right Parenthesis\n");
                    BEGIN(INITIAL);
                }

";"             {
                    printf("Semicolon\n");
                    BEGIN(INITIAL);
                }

<UNARY>";"      {
                    printf("Semicolon\n");
                    BEGIN(INITIAL);
                }

<UNARY>[ \t\n]+ { }

[ \t\n]+        { }

.               { }

%%

int main(int argc, char *argv[])
{
    if(argc > 1)
    {
        FILE *fp = fopen(argv[1], "r");

        if(fp == NULL)
        {
            printf("Cannot open input file\n");
            return 1;
        }

        yyin = fp;
    }
    else
    {
        printf("Usage: ./prog_1 input_1.txt\n");
        return 1;
    }

    yylex();

    fclose(yyin);

    return 0;
}
